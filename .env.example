# Lumexeda Portfolio — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────────────────────────
# GOOGLE DRIVE API KEY
# ─────────────────────────────────────────────────────────────────
# Required to display the live portfolio images from Google Drive.
#
# HOW TO GET YOUR API KEY (5 minutes):
#
#  1. Go to: https://console.cloud.google.com/
#  2. Create a new project or select an existing one.
#  3. In the left menu: APIs & Services → Library
#  4. Search for "Google Drive API" and click Enable.
#  5. In the left menu: APIs & Services → Credentials
#  6. Click "+ Create Credentials" → API key
#  7. Click "Edit API key" and apply restrictions:
#       API restrictions  → Restrict key → Google Drive API
#       Application type  → Websites     → add your domain(s)
#         e.g. localhost:3000 for development
#         e.g. lumexeda.com   for production
#  8. Copy the key and paste it below (replace the placeholder).
#
# NOTE: This key is stored here, server-side only.
#       It is NEVER sent to the browser.
# ─────────────────────────────────────────────────────────────────
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here

# Optional: change the port (default: 3000)
# PORT=3000
